LLM_PROVIDER=transformers
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:4b
LLM_MODEL_PATH=E:\video_agent_workflow_mvp\Qwen\Qwen3-4B
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.7
LLM_MAX_NEW_TOKENS=1024

COMFY_BASE_URL=http://127.0.0.1:8188
COMFY_WORKFLOW_PATH=workflows/simple_sdxl_t2i_api.json
COMFY_POSITIVE_NODE_ID=6
COMFY_NEGATIVE_NODE_ID=7
COMFY_CHECKPOINT_NODE_ID=4
COMFY_EMPTY_LATENT_NODE_ID=5
COMFY_SAVE_NODE_ID=9
COMFY_CHECKPOINT=48.safetensors
COMFY_WIDTH=1024
COMFY_HEIGHT=1024
COMFY_STEPS=30
COMFY_CFG=7.0
COMFY_SEED=-1

ANIMATIC_WIDTH=1280
ANIMATIC_HEIGHT=720
ANIMATIC_FPS=12

# Backends:
# - VIDEO_BACKEND=animatic copies storyboard animatics as shot videos.
# - VIDEO_BACKEND=command runs VIDEO_COMMAND per shot.
# Command placeholders: {shot_json}, {prompt}, {character_refs}, {scene_ref}, {animatic}, {output}
VIDEO_BACKEND=animatic
VIDEO_COMMAND=
VIDEO_OUTPUT_EXT=mp4

# Audio backends:
# - placeholder creates local WAV placeholders.
# - command runs the matching command template.
# Voice placeholders: {text}, {speaker}, {output}, {shot_json}
# BGM/SFX placeholders: {prompt}, {duration}, {output}, {shot_json}
VOICE_BACKEND=placeholder
VOICE_COMMAND=
BGM_BACKEND=placeholder
BGM_COMMAND=
SFX_BACKEND=placeholder
SFX_COMMAND=

# Sync backends:
# - passthrough keeps generated shot videos unchanged.
# - command runs SYNC_COMMAND per shot.
# Placeholders: {video}, {audio}, {output}, {shot_json}
SYNC_BACKEND=passthrough
SYNC_COMMAND=

COMPOSE_BACKEND=ffmpeg
OUTPUT_DIR=outputs
